# API base URL (used in browser). No trailing slash.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Max attachment upload size in MB (guest-list file on Create Request).
# The API accepts 10, but the live nginx proxy currently caps the body at its
# 1 MB default and 413s anything larger. Keep this at 1 to match nginx so users
# get a clear "too large" message instead of a 413. Once nginx's
# client_max_body_size is raised (see attachment-413-nginx-infra-handover.md),
# set this to 10 to use the full API limit. Defaults to 1 when unset.
NEXT_PUBLIC_MAX_UPLOAD_MB=1
